# Copy to .env and fill in. The .env file is gitignored — never commit secrets.

# PostgreSQL credentials (used by both the db container and wwfc).
DB_USER=wwfc
DB_PASSWORD=change-me-strong-password

# Secret for the loopback-only admin API. Generate one, e.g.:
#   openssl rand -hex 24
API_SECRET=change-me-random-hex

# NOTE: the server binds to 0.0.0.0 and does not need your LAN IP.
# Your LAN IP only goes in the ESP32 sketch (WFC_REDIRECT_IP) so the DS knows
# which box to reach. Find it with `ip route get 1.1.1.1` or `hostname -I`.
